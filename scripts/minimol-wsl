#!/bin/sh
# Start minimol's desktop window on WSL without /dev/dri. WebGL then needs a
# software renderer (llvmpipe), and Chromium's GPU compositor must be off: it
# tries to share frames through dma_buf and the window stays blank. Install
# this on PATH; it expects the venv at ~/minimol/.venv.
export MINIMOL_SOFTWARE_GL=1
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:+$QTWEBENGINE_CHROMIUM_FLAGS }--disable-gpu-compositing"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
exec "$HOME/minimol/.venv/bin/minimol" "$@"
